INTERNAL_MOUNT_DIR=/projects/CRBM/compose_api

AUTH0_DOMAIN=dev-bu7yo7484tyxu6a1.us.auth0.com
AUTH0_AUDIENCE=https://api.compose.cam.uchc.edu
# The web UI's Auth0 Single Page Application (auth0-pulumi `webapp_profiles.production`). Public: an SPA has no
# secret. Setting it turns on sign-in at /ui (docs/plan-webapp-login.md, W2).
AUTH0_SPA_CLIENT_ID=p7uif3ex4LijqPwSOJsPBnhCdClnxSMM
# Who may create, default and retire environment versions (docs/plan-environment-versions.md; plan-webapp-admin A5):
# the tenant's `admin` role (auth0-pulumi biosim-platform roles.py). ADMIN_ROLE, read every private simulation, stays unset.
ENVIRONMENT_ADMIN_ROLE=admin
# Who may mark, edit and clear suites' known problems (docs/plan-known-problems.md, K6): the same role.
SUITE_CURATOR_ROLE=admin
# Enforce the /ui Content-Security-Policy instead of only reporting (plan-webapp-admin step 4): report-only since
# 0.7.30 logged no violation, the sign-in flow included.
WEBAPP_CSP_ENFORCE=true
# Long runs (docs/authentication.md, "Longer runs"): holders of the tenant's `long-runs` role may simulate up to a day,
# with a SLURM limit scaled to the interval, up to 12 h. The cluster has no fair-share scheduler, so long runs from
# anyone would make an accidental denial of service too easy: they sit behind a role. No one runs long until the role
# is granted.
LONG_RUN_ROLE=long-runs
MAX_LONG_RUN_INTERVAL_TIME=86400
SLURM_MAX_TIME_LIMIT_MINUTES=720
# One person's runs on SLURM at once (docs/plan-durable-submission.md, Q3 and open question 3): 20 of the 100, so one
# student's many seeds can't hold every slot for the 12 h a long run may take. Anonymous runs count as one person.
SUBMISSION_MAX_ACTIVE_PER_REQUESTER=20
# A run in a composed environment (versions made by 0.7.108 or later) writes its results so far every 5 minutes, and
# once more when stopped at its time limit or cancelled (compose_api/environments/runner.py); one killed outright keeps
# the last of them.
CHECKPOINT_SECONDS=300

# Container builds as Kubernetes Jobs (compose_api/simulation/build_k8s.py): the SLURM build node cannot build
# (no /etc/subuid entry for svc_compose, so no fakeroot). The Job mounts the shared filesystem at the path the SLURM
# nodes read it at and copies the image there as svc_compose (the API pod's user).
BUILD_BACKEND=k8s
BUILD_K8S_NAMESPACE=compose-api-rke
BUILD_K8S_IMAGE=ghcr.io/apptainer/apptainer:1.3.6
BUILD_K8S_PVC_CLAIM=compose-api-home-pvc
BUILD_K8S_PVC_MOUNT_PATH=/projects/CRBM
BUILD_K8S_RUN_AS_UID=16997
BUILD_K8S_RUN_AS_GID=10000
BUILD_K8S_TIMEOUT_SECONDS=7200
# compose-api-private-source, the GitHub App that reads private repositories' source (its key: secret-github-app.yaml)
GITHUB_APP_ID=5850349
