INTERNAL_MOUNT_DIR=/projects/CRBM/compose_api
# Prebuilt simulator images by name (compose_api/simulation/prebuilt.py): `POST /simulation/run?simulator=<name>`
# runs in that image. Pinned by digest: the cached SIF is keyed on the reference.
PREBUILT_SIMULATORS={"viva-pde-particle": "ghcr.io/vivarium-collective/viva-pde-particle-compose@sha256:7ada62566485d57bcc33c359ae4e0c697da5c4e0faf83b9960d1d938c609849d"}

AUTH0_DOMAIN=dev-bu7yo7484tyxu6a1.us.auth0.com
AUTH0_AUDIENCE=https://api.compose.cam.uchc.edu
# Who may create, default and retire environment versions (docs/plan-environment-versions.md; plan-webapp-admin A5):
# the tenant's `admin` role (auth0-pulumi biosim-platform roles.py). ADMIN_ROLE, read every private simulation, stays unset.
ENVIRONMENT_ADMIN_ROLE=admin

# Container builds as Kubernetes Jobs (compose_api/simulation/build_k8s.py): the SLURM build node cannot build
# (no /etc/subuid entry for svc_compose, so no fakeroot). The Job mounts the shared filesystem at the path the SLURM
# nodes read it at and copies the image there as svc_compose (the API pod's user).
BUILD_BACKEND=k8s
BUILD_K8S_NAMESPACE=compose-api-rke
BUILD_K8S_IMAGE=ghcr.io/apptainer/apptainer:1.3.6
BUILD_K8S_PVC_CLAIM=compose-api-home-pvc
BUILD_K8S_PVC_MOUNT_PATH=/projects/CRBM
BUILD_K8S_RUN_AS_UID=16997
BUILD_K8S_RUN_AS_GID=10000
BUILD_K8S_TIMEOUT_SECONDS=7200
