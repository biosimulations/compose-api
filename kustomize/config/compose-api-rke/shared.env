# Submit through the in-cluster haproxy-ssh service (round-robin over mantis-sub-*), as sms-api does.
# mantis-svcsub.cam.uchc.edu rejects svc_compose's key; login.hpc accepts it but runs no commands.
# UCHHPC/mantis: svc_compose, account pi-agmon, partition vcell, QOS vcell-services.
SLURM_SUBMIT_HOST=haproxy-ssh
SLURM_SUBMIT_USER=svc_compose
SLURM_SUBMIT_KNOWN_HOSTS=/run/secrets/ssh-known-hosts/known_hosts
#SLURM_SUBMIT_KEY_PATH=/run/secrets/slurmsubmitkeyfile/ssh-privatekey
SLURM_PARTITION=vcell
SLURM_NODE_LIST=
SLURM_BUILD_NODE=mantis-042
SLURM_QOS=vcell-services
BATCH_SLURM_PARTITION=vcell
BATCH_SLURM_QOS=vcell-services

SIMULATION_STORE_BASE_PATH=/projects/CRBM/compose_api
HPC_SIM_CONFIG_FILE=publish-uchc-hpc.json
NAMESPACE=prod

NATS_URL=nats://nats:4222
NATS_WORKER_EVENT_SUBJECT=prod.publish

NATS_EMITTER_URL=nats://compose.cam.uchc.edu:30052
NATS_EMITTER_MAGIC_WORD=nats-emitter-magic-word
MARIMO_API_SERVER=http://api:8000
