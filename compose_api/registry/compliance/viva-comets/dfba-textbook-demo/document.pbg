{
  "state": {
    "community": {
      "_type": "process",
      "address": "local:DynamicFBAProcess",
      "config": {
        "models": ["textbook"],
        "model_ids": ["Ecoli"],
        "initial_biomass": [0.001],
        "initial_media": {
          "glc__D": 10.0,
          "o2": 40.0,
          "nh4": 1000.0,
          "pi": 1000.0,
          "h2o": 1000.0,
          "co2": 1000.0,
          "h": 1000.0,
          "ac": 0.0
        },
        "substep": 0.2
      },
      "inputs": {},
      "outputs": {
        "biomass": ["stores", "biomass"],
        "media": ["stores", "media"],
        "growth_rates": ["stores", "growth_rates"],
        "total_biomass": ["stores", "total_biomass"]
      },
      "interval": 1.0
    },
    "stores": {
      "biomass": {},
      "media": {},
      "growth_rates": {},
      "total_biomass": 0.0
    },
    "emitter": {
      "_type": "step",
      "address": "local:RAMEmitter",
      "config": {
        "emit": {
          "biomass": "map[float]",
          "media": "map[float]",
          "growth_rates": "map[float]",
          "total_biomass": "float",
          "time": "float"
        }
      },
      "inputs": {
        "biomass": ["stores", "biomass"],
        "media": ["stores", "media"],
        "growth_rates": ["stores", "growth_rates"],
        "total_biomass": ["stores", "total_biomass"],
        "time": ["global_time"]
      }
    }
  }
}
